    "Too small for this picture size: it will look blocky. Lower Scale or raise the size.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замало для такого розміру зображення: з’являться квадрати. Зменште масштаб або збільште розмір."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado pequeño para este tamaño de imagen: se verá pixelado. Baja la escala o aumenta el tamaño."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno demais para este tamanho de imagem: ficará pixelado. Reduza a escala ou aumente o tamanho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面サイズには小さすぎ、ブロックノイズが出ます。スケールを下げるかサイズを上げてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于此画面尺寸来说太小，画面会出现块状。请降低缩放或提高大小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면 크기에는 너무 작아 블록 현상이 생깁니다. 배율을 낮추거나 크기를 높이세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop petit pour cette taille d’image : elle sera pixellisée. Réduisez l’échelle ou augmentez la taille."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš malé pro tuto velikost obrazu: bude vypadat kostkovaně. Snižte měřítko nebo zvyšte velikost."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo piccolo per questa dimensione dell'immagine: apparirà a blocchi. Riduci la scala o aumenta la dimensione."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu kecil untuk ukuran gambar ini: akan tampak berpiksel. Turunkan skala atau naikkan ukuran."
          }
        }
      }
    },
    "The whole file ends up near this size. Scale and Frame rate still apply.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь файл матиме приблизно такий розмір. Масштаб і частота кадрів також враховуються."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo completo tendrá un tamaño cercano a este. La escala y la velocidad de fotogramas se siguen aplicando."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo inteiro terá um tamanho próximo a este. A escala e a taxa de quadros continuam valendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル全体がこのサイズに近くなります。スケールとフレームレートも適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个文件会接近此大小。缩放和帧率仍然有效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 파일이 이 크기에 가깝게 됩니다. 배율과 프레임 속도도 계속 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier entier aura une taille proche de celle-ci. L’échelle et la fréquence d’images s’appliquent toujours."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý soubor bude mít přibližně tuto velikost. Měřítko a snímková frekvence se stále uplatňují."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intero file avrà dimensioni vicine a questa. Scala e frequenza fotogrammi continuano ad applicarsi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh berkas akan mendekati ukuran ini. Skala dan Frame rate tetap berlaku."
          }
        }
      }
    },
