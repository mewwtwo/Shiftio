    "%@ will be moved to the Trash and the edited picture saved in its place.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде переміщено до Смітника, а відредаговане зображення збережеться на його місці."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se moverá a la Papelera y la imagen editada se guardará en su lugar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será movido para a Lixeira e a imagem editada será salva no lugar dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はゴミ箱に移動され、編集した画像が代わりに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将被移到废纸篓，编辑后的图片会保存在原位置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 휴지통으로 이동되고 편집한 이미지가 그 자리에 저장됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera placé dans la corbeille et l’image modifiée enregistrée à sa place."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bude přesunut do Koše a upravený obrázek se uloží na jeho místo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà spostato nel Cestino e l'immagine modificata salvata al suo posto."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dipindahkan ke Tempat Sampah dan gambar yang diedit disimpan sebagai gantinya."
          }
        }
      }
    },
