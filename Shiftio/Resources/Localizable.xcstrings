    "Cut rumble and turn down hiss between words": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрати гуркіт і приглушити шипіння між словами"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el ruido grave y baja el siseo entre palabras"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta o ruído grave e reduz o chiado entre as palavras"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低音のゴロゴロ音を除去し、言葉の間のヒスノイズを抑えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消除低频噪声，并降低词语之间的嘶嘶声"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웅웅거림을 없애고 단어 사이의 쉬익 소리를 줄입니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les grondements et atténue le souffle entre les mots"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní dunění a ztlumí syčení mezi slovy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il rimbombo e attenua il fruscio tra le parole"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memotong gemuruh dan menurunkan desis di antara kata"
          }
        }
      }
    },
