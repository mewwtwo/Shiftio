    "About %.0f MB for every minute of video, plus the sound.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно %.0f МБ на кожну хвилину відео, плюс звук."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %.0f MB por cada minuto de vídeo, más el sonido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %.0f MB por minuto de vídeo, mais o som."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画1分あたり約%.0f MB（音声を除く）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每分钟视频约 %.0f MB，另加音频。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 1분당 약 %.0f MB(소리 제외)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %.0f Mo par minute de vidéo, plus le son."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Asi %.0f MB na každou minutu videa, plus zvuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %.0f MB per ogni minuto di video, più l'audio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar %.0f MB untuk setiap menit video, ditambah suara."
          }
        }
      }
    },
    "The whole file ends up near this size, so the picture gets about %.1f Mbps.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь файл матиме приблизно такий розмір, тому на зображення припадає близько %.1f Мбіт/с."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo completo tendrá un tamaño cercano a este, así que la imagen recibe unos %.1f Mbps."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo inteiro terá um tamanho próximo a este, então a imagem recebe cerca de %.1f Mbps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル全体がこのサイズに近くなり、映像には約%.1f Mbpsが割り当てられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个文件会接近此大小，因此画面约为 %.1f Mbps。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 파일이 이 크기에 가깝게 되며, 영상에는 약 %.1f Mbps가 할당됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier entier aura une taille proche de celle-ci ; l’image reçoit environ %.1f Mbit/s."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý soubor bude mít přibližně tuto velikost, takže obraz dostane asi %.1f Mb/s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intero file avrà dimensioni vicine a questa, quindi l'immagine riceve circa %.1f Mbps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh berkas akan mendekati ukuran ini, sehingga gambar mendapat sekitar %.1f Mbps."
          }
        }
      }
    },
    "Scale and Frame rate still apply.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштаб і частота кадрів також враховуються."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escala y la velocidad de fotogramas se siguen aplicando."
          }
        },
