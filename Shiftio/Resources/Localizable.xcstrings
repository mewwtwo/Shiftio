    "Takes effect after Shiftio restarts. If macOS uses a language Shiftio doesn't have yet, English is shown.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набуде чинності після перезапуску Shiftio. Якщо macOS використовує мову, якої в Shiftio ще немає, відображається англійська."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al reiniciar Shiftio. Si macOS usa un idioma que Shiftio aún no tiene, se muestra inglés."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale após reiniciar o Shiftio. Se o macOS usar um idioma que o Shiftio ainda não tem, o inglês é exibido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftioの再起動後に反映されます。macOSの言語にShiftioが対応していない場合は英語で表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 Shiftio 后生效。如果 macOS 使用的语言 Shiftio 尚未支持，则显示英语。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio를 다시 시작하면 적용됩니다. macOS 언어를 Shiftio가 아직 지원하지 않으면 영어로 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet après le redémarrage de Shiftio. Si macOS utilise une langue que Shiftio n’a pas encore, l’anglais est affiché."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeví se po restartu Shiftio. Pokud macOS používá jazyk, který Shiftio zatím nemá, zobrazí se angličtina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha effetto dopo il riavvio di Shiftio. Se macOS usa una lingua che Shiftio non ha ancora, viene mostrato l'inglese."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku setelah Shiftio dimulai ulang. Jika macOS memakai bahasa yang belum tersedia di Shiftio, bahasa Inggris ditampilkan."
          }
        }
      }
    },
