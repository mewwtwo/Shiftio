    "Double-click a slider to put it back to its default.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі клацніть повзунок, щоб повернути типове значення."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un control deslizante para devolverlo a su valor predeterminado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em um controle deslizante para voltar ao padrão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダをダブルクリックすると初期値に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击滑块可恢复默认值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더를 두 번 클릭하면 기본값으로 돌아갑니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un curseur pour le remettre à sa valeur par défaut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojklikem na posuvník obnovíte výchozí hodnotu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai doppio clic su un cursore per riportarlo al valore predefinito."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
