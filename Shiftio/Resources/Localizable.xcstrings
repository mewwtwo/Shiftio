    "Shiftio only asks for what a feature needs, and only when you press Allow.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio просить лише те, що потрібно функції, і лише коли ви натиснете «Дозволити»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio solo pide lo que necesita cada función, y solo cuando pulsas Permitir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Shiftio só pede o que um recurso precisa, e só quando você pressiona Permitir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftioは機能に必要なものだけを、「許可」を押したときにだけ求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio 只会请求功能所需的权限，并且仅在你点按“允许”时才会请求。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio는 기능에 필요한 것만, 그리고 허용을 누를 때만 요청합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio ne demande que ce dont une fonction a besoin, et seulement lorsque vous cliquez sur Autoriser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio žádá jen o to, co funkce potřebuje, a jen když stisknete Povolit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio chiede solo ciò che serve a una funzione, e solo quando premi Consenti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiftio hanya meminta yang dibutuhkan fitur, dan hanya saat Anda menekan Izinkan."
          }
        }
      }
    },
