    "Bring the level of speech to a comfortable, even volume": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вирівняти рівень мовлення до комфортної рівної гучності"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el nivel de la voz a un volumen cómodo y uniforme"
          }
        },
