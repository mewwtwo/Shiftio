    "Try it right here: press %@, then drag the file onto an action.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте просто тут: натисніть %@, потім перетягніть файл на дію."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo aquí mismo: pulsa %@ y arrastra el archivo sobre una acción."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente aqui mesmo: pressione %@ e arraste o arquivo sobre uma ação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで試してみましょう：%@を押してから、ファイルをアクションにドラッグします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就在这里试试：按 %@，然后把文件拖到某个操作上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 바로 해 보세요: %@을(를) 누른 다음 파일을 동작 위로 드래그하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez ici : appuyez sur %@, puis faites glisser le fichier sur une action."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to přímo tady: stiskněte %@ a přetáhněte soubor na akci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova subito qui: premi %@, poi trascina il file su un'azione."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba langsung di sini: tekan %@, lalu seret berkas ke sebuah tindakan."
          }
        }
      }
    },
