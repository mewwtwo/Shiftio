    "System controls without leaving what you're doing. Hold the keys for a moment.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системні елементи керування, не відриваючись від справ. Утримуйте клавіші мить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles del sistema sin dejar lo que estás haciendo. Mantén pulsadas las teclas un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles do sistema sem sair do que você está fazendo. Segure as teclas por um instante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業を中断せずにシステムを操作できます。キーをしばらく押し続けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需离开当前工作即可使用系统控制。按住按键片刻。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하던 일을 멈추지 않고 시스템 제어를 사용하세요. 키를 잠시 누르고 계세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages système sans quitter ce que vous faites. Maintenez les touches un instant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládání systému, aniž byste přerušili práci. Chvíli podržte klávesy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlli di sistema senza interrompere ciò che stai facendo. Tieni premuti i tasti per un momento."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol sistem tanpa meninggalkan pekerjaan Anda. Tahan tombolnya sejenak."
          }
        }
      }
    },
