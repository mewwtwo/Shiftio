    "The Audio sector in the ring uses this format. Each format is also its own sector in Rings.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сектор «Аудіо» в кільці використовує цей формат. Кожен формат також має власний сектор у розділі «Кільця»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sector Audio del anillo usa este formato. Cada formato es también un sector propio en Anillos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O setor Áudio do anel usa este formato. Cada formato também é um setor próprio em Anéis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングの「オーディオ」セクターはこの形式を使います。各形式は「リング」の中で個別のセクターにもなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环中的“音频”扇区使用此格式。每种格式在“圆环”中也有各自的扇区。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링의 오디오 섹터는 이 형식을 사용합니다. 각 형식은 링에서 별도의 섹터이기도 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le secteur Audio de l’anneau utilise ce format. Chaque format a aussi son propre secteur dans Anneaux."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sektor Zvuk v kruhu používá tento formát. Každý formát má také vlastní sektor v Kruzích."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il settore Audio nell'anello usa questo formato. Ogni formato è anche un settore a sé in Anelli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sektor Audio di cincin memakai format ini. Setiap format juga menjadi sektor tersendiri di Cincin."
          }
        }
      }
    },
