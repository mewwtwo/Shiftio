          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每页都会变成图片，因此无法选择或搜索文字。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 페이지가 이미지가 되므로 텍스트를 선택하거나 검색할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque page devient une image : le texte ne peut plus être sélectionné ni recherché."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá stránka se stane obrázkem, text proto nelze vybrat ani vyhledat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pagina diventa un'immagine, quindi il testo non può essere selezionato né cercato."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap halaman menjadi gambar, sehingga teks tidak dapat dipilih atau dicari."
          }
        }
      }
    },
