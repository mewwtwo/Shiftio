    "Keeps the same look all the way through. The file size follows from the picture: busy scenes take more.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає однаковий вигляд до кінця. Розмір файлу залежить від зображення: динамічні сцени займають більше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el mismo aspecto de principio a fin. El tamaño del archivo depende de la imagen: las escenas con mucho movimiento ocupan más."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o mesmo visual do início ao fim. O tamanho do arquivo depende da imagem: cenas movimentadas ocupam mais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体を通して同じ見た目を保ちます。ファイルサイズは映像によって決まり、動きの多いシーンほど大きくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全程保持相同画质。文件大小取决于画面：运动多的场景会占用更多空间。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음부터 끝까지 같은 화질을 유지합니다. 파일 크기는 화면에 따라 달라지며, 움직임이 많은 장면은 더 커집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le même rendu du début à la fin. La taille du fichier dépend de l’image : les scènes chargées pèsent plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovává stejný vzhled po celou dobu. Velikost souboru závisí na obraze: rušné scény zabírají víc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene lo stesso aspetto dall'inizio alla fine. La dimensione del file dipende dall'immagine: le scene movimentate pesano di più."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan tampilan yang sama sepanjang video. Ukuran berkas mengikuti gambar: adegan yang ramai memakan lebih banyak."
          }
        }
      }
    },
